{
  "name": "faceless-video-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Faceless Video Studio \u2014 prompt or script to narrated faceless video, by GMK Media Ltd.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "db:push": "tsx scripts/db-push.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:reset": "rm -rf .data/pgdata && tsx scripts/db-push.ts && tsx scripts/db-seed.ts",
    "worker": "tsx services/worker/main.ts",
    "smoke": "tsx scripts/smoke-pipeline.ts",
    "doctor": "tsx scripts/doctor.ts",
    "selftest": "tsx scripts/selftest.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.73.0",
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@electric-sql/pglite": "^0.5.8",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "jose": "^6.2.12",
    "lucide-react": "^0.552.0",
    "next": "16.4.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "stripe": "^23.0.0",
    "tailwind-merge": "^3.4.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
