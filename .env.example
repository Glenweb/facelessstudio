# ─────────────────────────────────────────────────────────────────────────────
# Faceless Video Studio — environment
#
# EVERY key below is OPTIONAL. With none set, the app boots in LOCAL STUDIO
# MODE: embedded Postgres (PGlite), procedural scene visuals, in-process
# preview voice, and REAL FFmpeg rendering on this machine. The full
# prompt -> script -> scenes -> voiceover -> MP4 pipeline works offline.
# Add a key and that one provider silently upgrades to the real vendor.
# `npm run doctor` prints exactly which mode each provider is in.
# ─────────────────────────────────────────────────────────────────────────────

# --- Core ---
# 32+ byte secret for session cookies. Auto-generated into .data/ if unset.
AUTH_SECRET=
APP_URL=http://localhost:3000

# --- Database (Neon Postgres in production) ---
# Unset => embedded PGlite at .data/pgdata
DATABASE_URL=

# --- Scripting & scene breakdown (Anthropic Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Scene visuals (Google AI Studio / Gemini) ---
GOOGLE_AI_STUDIO_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# --- Voiceover (ElevenLabs) ---
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Render node (FFmpeg on Railway) ---
# Unset => render locally with the ffmpeg binary on PATH
RENDER_NODE_URL=
RENDER_NODE_TOKEN=

# --- Customer file storage (Cloudflare R2) ---
# Unset => local filesystem at .data/storage, served via /api/media/*
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=faceless-studio
R2_PUBLIC_BASE_URL=

# --- YouTube Data API v3 ---
# Unset => upload returns a dry-run payload (incl. synthetic-content disclosure)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/youtube/callback

# --- Stripe credit billing ---
# Unset => credit packs are granted instantly in sandbox mode
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_STUDIO=
